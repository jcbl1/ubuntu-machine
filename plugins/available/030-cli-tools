#!/bin/bash
# 030-cli-tools - 常用 CLI 工具（apt）+ fd 软链修复
#
# 包集合与本容器手工安装的集合一致，另补 unzip（060-yazi 解压用）与 less。
# fd-find 在 Ubuntu 上二进制叫 fdfind；all-in-one.zsh 的 FZF_DEFAULT_COMMAND
# 用的是 fd，这里补一个 /usr/local/bin/fd 软链。
#
# 幂等：apt 重复安装无害，软链存在则跳过。
# 构建期/运行期均可执行（纯 root 操作，不依赖 TARGET_USER）。

set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends \
  git zsh tmux fzf ripgrep fd-find bat btop htop ncdu \
  lsof rsync vim strace unzip less

# fdfind -> fd（all-in-one.zsh: FZF_DEFAULT_COMMAND="fd --type f"）
if command -v fdfind >/dev/null && [[ ! -e /usr/local/bin/fd ]]; then
  ln -s "$(command -v fdfind)" /usr/local/bin/fd
fi

apt-get clean
rm -rf /var/lib/apt/lists/*
