#!/bin/bash
# 040-zsh - oh-my-zsh + zsh 配置（用户级）
#
# 部署内容（与既有容器逐字一致，适配见下）：
#   ~/.zshrc                主题 risto、插件列表、nvm、yazi y()、fzf 配置
#                           （差异：opencode PATH 的硬编码 /home/jcbl1 改为 $HOME）
#   ~/.zshenv               cargo env（差异：加 -f 存在性保护）
#   custom/all-in-one.zsh   别名与导出（差异：剔除 Mac 专属段，pc 代理参数化）
#   custom/plugins/zsh-autosuggestions
#
# 运行期由 run-plugins 注入 TARGET_USER；构建期无用户则整体跳过。

set -euo pipefail

if [[ -z "${TARGET_USER:-}" ]] || ! id "$TARGET_USER" >/dev/null 2>&1; then
  echo "040-zsh: 无目标用户（构建期？），跳过用户级配置"
  exit 0
fi

TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
TARGET_GROUP="$(id -gn "$TARGET_USER")"
as_user() { runuser -u "$TARGET_USER" -- env "HOME=$TARGET_HOME" "$@"; }

ZSH_CUSTOM="$TARGET_HOME/.oh-my-zsh/custom"

# ---- oh-my-zsh（unattended，不切 shell、不启 zsh）----
if [[ ! -d "$TARGET_HOME/.oh-my-zsh" ]]; then
  as_user bash -c 'RUNZSH=no CHSH=no sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"'
else
  echo "040-zsh: oh-my-zsh 已存在，跳过安装"
fi
as_user mkdir -p "$ZSH_CUSTOM/plugins"

# ---- 第三方插件：zsh-autosuggestions ----
if [[ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]]; then
  as_user git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions \
    "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
else
  echo "040-zsh: zsh-autosuggestions 已存在，跳过"
fi

# ---- ~/.zshrc ----
cat > "$TARGET_HOME/.zshrc" <<'ZSHRC'
# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
# ZSH_THEME="robbyrussell"
# ZSH_THEME="candy"
# ZSH_THEME="random"
ZSH_THEME="risto"

# Set list of themes to pick from when loading at random
# Setting this variable when ZSH_THEME=random will cause zsh to load
# a theme from this variable instead of looking in $ZSH/themes/
# If set to an empty array, this variable will have no effect.
# ZSH_THEME_RANDOM_CANDIDATES=( "robbyrussell" "agnoster" )

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion.
# Case-sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment one of the following lines to change the auto-update behavior
# zstyle ':omz:update' mode disabled  # disable automatic updates
# zstyle ':omz:update' mode auto      # update automatically without asking
# zstyle ':omz:update' mode reminder  # just remind me to update when it's time

# Uncomment the following line to change how often to auto-update (in days).
# zstyle ':omz:update' frequency 13

# Uncomment the following line if pasting URLs and other text is messed up.
# DISABLE_MAGIC_FUNCTIONS="true"

# Uncomment the following line to disable colors in ls.
# DISABLE_LS_COLORS="true"

# Uncomment the following line to disable auto-setting terminal title.
# DISABLE_AUTO_TITLE="true"

# Uncomment the following line to enable command auto-correction.
# ENABLE_CORRECTION="true"

# Uncomment the following line to display red dots whilst waiting for completion.
# You can also set it to another string to have that shown instead of the default red dots.
# e.g. COMPLETION_WAITING_DOTS="%F{yellow}waiting...%f"
# Caution: this setting can cause issues with multiline prompts in zsh < 5.7.1 (see #5765)
# COMPLETION_WAITING_DOTS="true"

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
# HIST_STAMPS="mm/dd/yyyy"

# Would you like to use another custom folder than $ZSH/custom?
# ZSH_CUSTOM=/path/to/new-custom-folder

# Which plugins would you like to load?
# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
# Example format: plugins=(rails git textmate ruby lighthouse)
# Add wisely, as too many plugins slow down shell startup.
plugins=(git sudo colored-man-pages cp systemd z colorize zsh-autosuggestions fzf)

source $ZSH/oh-my-zsh.sh

# User configuration

# export MANPATH="/usr/local/man:$MANPATH"

# You may need to manually set your language environment
# export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
# if [[ -n $SSH_CONNECTION ]]; then
#   export EDITOR='vim'
# else
#   export EDITOR='nvim'
# fi

# Compilation flags
# export ARCHFLAGS="-arch $(uname -m)"

# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

# Load nvm commands without selecting or switching a Node version.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh" --no-use
[ -s "$NVM_DIR/bash_completion" ] && source "$NVM_DIR/bash_completion"

# yazi
export PATH="$HOME/.local/bin:$PATH"

# yazi: exit and cd to last visited directory
function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# fzf configuration
export FZF_DEFAULT_COMMAND='find . -type f -not -path "*/node_modules/*" -not -path "*/.git/*" 2>/dev/null'
export FZF_DEFAULT_OPTS='--height 40% --border --preview "bat --color=always --style=numbers --line-range=:100 {} 2>/dev/null || cat {}" --preview-window=right:60%:wrap'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='find . -type d -not -path "*/node_modules/*" -not -path "*/.git/*" 2>/dev/null'
export FZF_CTRL_R_OPTS="--preview 'echo {}'"

# fzf key bindings (Ctrl-T: file, Ctrl-R: history, Alt-C: cd)
eval "$(fzf --zsh 2>/dev/null)" || {
  [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]] && source /usr/share/doc/fzf/examples/key-bindings.zsh
}
ZSHRC

# ---- ~/.zshenv ----
cat > "$TARGET_HOME/.zshenv" <<'ZSHENV'
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
ZSHENV

# ---- custom/all-in-one.zsh（容器版）----
cat > "$ZSH_CUSTOM/all-in-one.zsh" <<'ALLINONE'
#### all-in-one.zsh（容器版）
# 由 ubuntu-machine/plugins/available/040-zsh 部署。
# 与 Mac 版的差异：剔除 pycharm/mpv/homebrew-nvm 等 Mac 专属段；
# pc 代理别名参数化；bun PATH 兜底；fzf/y() 定义以 ~/.zshrc 为准。

#### aliases
#
alias df='df -h'
alias du='du -h'
alias hd1='du -hd1|sort -h'
alias l.='ls -dla'
alias lsr='ls -la -s size'
alias lsd='ls -la -s date'
alias haveMyKeystoGithubInserted='eval `ssh-agent`&&ssh-add $HOME/.ssh/github-jcbl1'
alias hv='eval `ssh-agent`&&ssh-add $HOME/.ssh/github-jcbl1'
alias vi='vim'
alias tm='tmux'
alias tma='tmux a'
alias gf...='go fmt ./...'
alias gr.='go run .'
alias gg...='go get ./...'

alias in='sudo apt install'
alias up='sudo apt update && sudo apt upgrade'
alias un='sudo apt remove'

alias ..github='cd ~/Documents/github.com'

alias pn=pnpm

alias k=kubectl

# 宿主机代理：可用 export PROXY_HOST/PROXY_PORT 覆盖，或直接改下面两个默认值
_PROXY_HOST="${PROXY_HOST:-192.168.64.1}"
_PROXY_PORT="${PROXY_PORT:-20121}"
alias pc="http_proxy=http://${_PROXY_HOST}:${_PROXY_PORT} https_proxy=http://${_PROXY_HOST}:${_PROXY_PORT} all_proxy=http://${_PROXY_HOST}:${_PROXY_PORT}"
unset _PROXY_HOST _PROXY_PORT

alias cn=container

# yazi wrapper（y() 定义在 ~/.zshrc，此处只补别名）
alias lf='y'

#### exports
#
export LANG=C.UTF-8
export EDITOR=vim
export LESS="-R"
export PATH="$PATH:$HOME/go/bin"
export FZF_DEFAULT_COMMAND="fd --type f"

# opencode
export OPENCODE_ENABLE_EXA=1
export OPENCODE_EXPERIMENTAL_LSP_TOOL=true

# for asdf
export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"

# bun（安装后自动生效）
[ -d "$HOME/.bun/bin" ] && export PATH="$HOME/.bun/bin:$PATH"

## other
#source <(fzf --zsh)

## nvm 由 ~/.zshrc 加载

# zsh-autosuggestions
export ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="underline"
ALLINONE

# ---- bash 启动文件（~/.bashrc / ~/.profile）----
# 与既有容器一致：bash 交互/登录 shell 同样拿到 opencode PATH、cargo、nvm
# （本环境 CONTAINER_SHELL=/bin/bash，脚本与登录 bash 都会读这些文件）。
# 用标记块保证幂等：块内内容每次重写，块外用户改动不受影响。
upsert_bash_block() {
  local file="$1"
  local begin='# >>> ubuntu-machine bash env >>>'
  local end='# <<< ubuntu-machine bash env <<<'
  if [[ -f "$file" ]] && grep -qF "$begin" "$file"; then
    awk -v b="$begin" -v e="$end" \
      '$0==b {inblock=1} inblock && $0==e {inblock=0; next} !inblock {print}' \
      "$file" > "$file.tmp" && mv "$file.tmp" "$file"
  fi
  [[ -f "$file" ]] || : > "$file"
  [[ -s "$file" && "$(tail -c1 "$file")" != "" ]] && printf '\n' >> "$file"
  cat >> "$file"
}

upsert_bash_block "$TARGET_HOME/.bashrc" <<'BASHRC_ENV'
# >>> ubuntu-machine bash env >>>
# opencode
export PATH="$HOME/.opencode/bin:$PATH"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"
# <<< ubuntu-machine bash env <<<
BASHRC_ENV

upsert_bash_block "$TARGET_HOME/.profile" <<'PROFILE_ENV'
# >>> ubuntu-machine bash env >>>
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
# <<< ubuntu-machine bash env <<<
PROFILE_ENV

# ---- 属主与登录 shell ----
chown -R "$TARGET_USER:$TARGET_GROUP" \
  "$TARGET_HOME/.oh-my-zsh" "$TARGET_HOME/.zshrc" "$TARGET_HOME/.zshenv" \
  "$TARGET_HOME/.bashrc" "$TARGET_HOME/.profile"

zsh_path="$(command -v zsh || true)"
if [[ -n "$zsh_path" && "$(getent passwd "$TARGET_USER" | cut -d: -f7)" != "$zsh_path" ]]; then
  chsh -s "$zsh_path" "$TARGET_USER"
fi

echo "040-zsh: 完成（用户 $TARGET_USER）"
