#!/bin/bash
# 090-opencode - opencode 配置（认证不入库，留给 `opencode auth login`）
#
# 部署 ~/.config/opencode/ 下的 opencode.jsonc、cli.json 与
# opencode-notifier.json，均为 OpenCode V2 原生格式：
#   - opencode.jsonc: websearch + permissions 数组 + mcp.servers 服务器
#     （reactive-resume / anymd / notion / excalidraw / n8n，playwright
#     保留注释）+ notifier 插件。V2 使用 mcp.servers 与 disabled，不使用
#     V1 的 mcp.<name> / enabled。mcp 命令里的 nvm-exec 路径随 TARGET_HOME
#     变化，用占位符注入后再 sed 替换；n8n 的 cwd 指向宿主 n8n-workflows 项目。
#   - cli.json: 终端层 UI 配置，禁用内置 opencode.notifications，避免与
#     notifier 重复提醒；session.permissions 保留 TUI 的权限询问行为。
# notifier 插件（@mohak34/opencode-notifier）单包同时支持 V1/V2：V2 下由
# opencode 依据 jsonc 的 "plugins" 字段自动安装，终端组件由 CLI 自动加载。
# 二进制缺失或检测到 V1 时，用官方 V2 安装脚本替换为用户级
# ~/.opencode/bin/opencode（--no-modify-path，PATH 由 040-zsh 负责）。
#
# 运行期由 run-plugins 注入 TARGET_USER；构建期无用户则整体跳过。

set -euo pipefail

if [[ -z "${TARGET_USER:-}" ]] || ! id "$TARGET_USER" >/dev/null 2>&1; then
  echo "090-opencode: 无目标用户（构建期？），跳过用户级配置"
  exit 0
fi

TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
TARGET_GROUP="$(id -gn "$TARGET_USER")"
as_user() { runuser -u "$TARGET_USER" -- env "HOME=$TARGET_HOME" "$@"; }

install -d -m 755 -o "$TARGET_USER" -g "$TARGET_GROUP" \
  "$TARGET_HOME/.config" "$TARGET_HOME/.config/opencode"

# ---- opencode.jsonc（V2 原生格式）----
# mcp 命令里的 nvm-exec 路径依赖 TARGET_HOME，用占位符注入后再 sed 替换。
jsonc_tmp="$(mktemp)"
cat > "$jsonc_tmp" <<'OCJSONC'
{
  "$schema": "https://opencode.ai/config.json",
  "websearch": {
    "provider": "random"
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "reactive-resume": {
        "type": "remote",
        "url": "https://me.yelr.de/mcp",
        "oauth": {
          "callback_port": 19876
        },
        "disabled": true
      },
      "anymd": {
        "type": "local",
        "command": ["__TARGET_HOME__/.nvm/nvm-exec", "npx", "-y", "@sylphx/anymd"],
        "environment": {
          "NODE_VERSION": "22"
        },
        "disabled": true
      },
      // "playwright": {
      //   "type": "local",
      //   "command": ["__TARGET_HOME__/.nvm/nvm-exec", "npx", "-y", "@playwright/mcp@latest"],
      //   "environment": {
      //     "NODE_VERSION": "22"
      //   },
      //   "disabled": true
      // },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "oauth": {
          "callback_port": 19876
        },
        "disabled": true
      },
      "excalidraw": {
        "type": "remote",
        "url": "https://mcp.excalidraw.com",
        "disabled": true
      },
      "n8n": {
        "type": "local",
        "command": ["__TARGET_HOME__/.nvm/nvm-exec", "npx", "-y", "n8n-mcp"],
        "cwd": "/Users/jcbl1/Developer/github.com/jcbl1/n8n-workflows",
        "environment": {
          "NODE_VERSION": "22",
          "MCP_MODE": "stdio",
          "LOG_LEVEL": "error",
          "DISABLE_CONSOLE_OUTPUT": "true"
        },
        "disabled": true
      }
    }
  },
  "plugins": ["@mohak34/opencode-notifier@latest"]
}
OCJSONC
sed -i "s|__TARGET_HOME__|$TARGET_HOME|g" "$jsonc_tmp"
install -m 644 -o "$TARGET_USER" -g "$TARGET_GROUP" \
  "$jsonc_tmp" "$TARGET_HOME/.config/opencode/opencode.jsonc"
rm -f "$jsonc_tmp"

# ---- cli.json（终端层配置；禁用内置通知，避免与 notifier 重复）----
cat > "$TARGET_HOME/.config/opencode/cli.json" <<'OCCLI'
{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": ["*", "-opencode.notifications"],
  "tabs": {
    "mode": "off"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "permissions": "prompt"
  },
  "animations": true
}
OCCLI

# ---- opencode-notifier.json ----
cat > "$TARGET_HOME/.config/opencode/opencode-notifier.json" <<'OCNOTIFIER'
{
  "sound": true,
  "notification": true,
  "notificationSystem": "ghostty",
  "bell": false,
  "suppressWhenFocused": false,
  "showProjectName": true,
  "timeout": 5
}
OCNOTIFIER

chown "$TARGET_USER:$TARGET_GROUP" \
  "$TARGET_HOME/.config/opencode/opencode.jsonc" \
  "$TARGET_HOME/.config/opencode/cli.json" \
  "$TARGET_HOME/.config/opencode/opencode-notifier.json"

# ---- 二进制兜底（要求 V2；检测到 V1 时用官方 V2 安装器替换）----
opencode_bin="$TARGET_HOME/.opencode/bin/opencode"
if [[ ! -x "$opencode_bin" ]]; then
  opencode_bin="$(command -v opencode 2>/dev/null || true)"
fi

version=""
if [[ -n "$opencode_bin" && -x "$opencode_bin" ]]; then
  version="$(as_user "$opencode_bin" --version 2>/dev/null | head -n1 || true)"
fi

major=0
if [[ "$version" =~ ([0-9]+)\. ]]; then
  major="${BASH_REMATCH[1]}"
fi

if [[ "$major" -ge 2 ]]; then
  echo "090-opencode: 已安装 V2（$version），跳过安装"
else
  if [[ -n "$version" ]]; then
    echo "090-opencode: 检测到 OpenCode V1（$version），替换为 V2"
  else
    echo "090-opencode: 未检测到可用的 opencode，安装 V2"
  fi

  as_user bash -c 'curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path'

  opencode_bin="$TARGET_HOME/.opencode/bin/opencode"
  version="$("$opencode_bin" --version 2>/dev/null | head -n1 || true)"
  if [[ ! "$version" =~ ([0-9]+)\. ]] || (( BASH_REMATCH[1] < 2 )); then
    echo "090-opencode: V2 安装后版本校验失败: ${version:-<empty>}" >&2
    exit 1
  fi
  echo "090-opencode: 已安装 V2（$version）"
fi

echo "090-opencode: 完成（用户 $TARGET_USER；认证请手动执行: opencode auth login）"
