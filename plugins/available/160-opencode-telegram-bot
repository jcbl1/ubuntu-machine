#!/bin/bash
# 160-opencode-telegram-bot - 从 Telegram 远程驱动 opencode 的第三方 bot 启动器
#
# bot 本体是第三方 npm 包（@grinev/opencode-telegram-bot），不落地源码，由启动器
# 按需 npx 拉取。密钥（.env）不放这里，由 080-private 从
# plugins/private/opencode-telegram-bot.env 落位（600）。
#
# 依赖：100-nvm（nvm/node），编号在前，先执行。
# Telegram 代理走 bot 自带的 TELEGRAM_PROXY_URL（见 private/ 的 .env），
# 不再用 proxychains 包裹整个进程：proxychains 会把发往 127.0.0.1 的
# opencode API 请求也转发给宿主代理，导致本机服务不可达或 401。
#
# 部署（用户级）：
#   ~/opencode-telegram-bot/run-bot.sh   启动器（nvm 定位 node -> PATH -> npx）
#   ~/opencode-telegram-bot/.nvmrc       使用的 Node 版本（默认 v22.23.2）
#   ~/.config/opencode-telegram-bot/     运行数据目录（700，放 .env / settings.json / logs）
#   /etc/systemd/system/opencode-telegram-bot.service
#                                        systemd unit（依赖 095-opencode-server）
#
# 仅当 .env 已存在时才 enable/启动服务，避免无密钥时反复重启；unit 文件始终落位。
# systemd 未运行时（构建期）只落文件。
#
# 运行期由 run-plugins 注入 TARGET_USER；构建期无用户则整体跳过。

set -euo pipefail

if [[ -z "${TARGET_USER:-}" ]] || ! id "$TARGET_USER" >/dev/null 2>&1; then
  echo "160-opencode-telegram-bot: 无目标用户（构建期？），跳过用户级配置"
  exit 0
fi

TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
TARGET_GROUP="$(id -gn "$TARGET_USER")"

NODE_VERSION="${TELEGRAM_BOT_NODE_VERSION:-v22.23.2}"

install -d -m 755 -o "$TARGET_USER" -g "$TARGET_GROUP" \
  "$TARGET_HOME/opencode-telegram-bot" \
  "$TARGET_HOME/.config"
install -d -m 700 -o "$TARGET_USER" -g "$TARGET_GROUP" \
  "$TARGET_HOME/.config/opencode-telegram-bot"

# ---- .nvmrc ----
printf '%s\n' "$NODE_VERSION" > "$TARGET_HOME/opencode-telegram-bot/.nvmrc"
chown "$TARGET_USER:$TARGET_GROUP" "$TARGET_HOME/opencode-telegram-bot/.nvmrc"
chmod 644 "$TARGET_HOME/opencode-telegram-bot/.nvmrc"

# ---- run-bot.sh ----
cat > /tmp/opencode-telegram-bot-run.sh <<'RUNBOT'
#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$SCRIPT_DIR"

NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
NODE_VERSION="$(tr -d 'v \r\n' < "$SCRIPT_DIR/.nvmrc" 2>/dev/null || true)"
NODE_VERSION="${NODE_VERSION:-22.23.2}"
NODE_BIN="$NVM_DIR/versions/node/v${NODE_VERSION}/bin"

if [ ! -x "$NODE_BIN/npx" ]; then
  export NVM_DIR
  # nvm.sh 加载时会自动 use 当前目录的 .nvmrc；首次启动时该版本尚未安装，
  # 在 set -e 下会以 3 退出（且无输出），导致永远走不到 nvm install。
  # 用 --no-use 跳过自动切换，装好后再显式 use。
  # nvm 内部多处直接引用未定义变量，与 set -u 不兼容，期间临时关闭。
  set +u
  . "$NVM_DIR/nvm.sh" --no-use
  nvm install
  nvm use
  NODE_BIN="$(dirname "$(nvm which current)")"
  set -u
fi

# 新建容器时 opencode service 会重新生成密码，而 bot 的 .env 由 private/ 复制而来
# （沿用旧容器的密码）。指向本机服务时以运行中服务的注册表为准，避免 401。
conf="$HOME/.config/opencode-telegram-bot/.env"
api_url="$(sed -n 's/^OPENCODE_API_URL=//p' "$conf" 2>/dev/null | tail -n1)"
case "${api_url:-http://127.0.0.1:49374}" in
  http://127.0.0.1:*|http://localhost:*)
    registry="$HOME/.local/state/opencode/service.json"
    if [ -r "$registry" ]; then
      password="$(sed -n 's/.*"password"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$registry" | head -n1)"
      if [ -n "$password" ]; then
        OPENCODE_SERVER_PASSWORD="$password"
        export OPENCODE_SERVER_PASSWORD
      fi
    fi
    ;;
esac

export PATH="$NODE_BIN:/usr/local/bin:/usr/bin:/bin"
exec "$NODE_BIN/npx" "@grinev/opencode-telegram-bot@latest"
RUNBOT
install -m 755 -o "$TARGET_USER" -g "$TARGET_GROUP" \
  /tmp/opencode-telegram-bot-run.sh "$TARGET_HOME/opencode-telegram-bot/run-bot.sh"
rm -f /tmp/opencode-telegram-bot-run.sh

# ---- systemd unit ----
unit_tmp="$(mktemp)"
cat > "$unit_tmp" <<'UNIT'
# opencode-telegram-bot.service — 从 Telegram 远程驱动 opencode
# 由 ubuntu-machine/plugins/available/160-opencode-telegram-bot 部署。
[Unit]
Description=OpenCode Telegram Bot
After=network-online.target opencode-server.service
Wants=network-online.target opencode-server.service

[Service]
Type=simple
User=__TARGET_USER__
Environment=HOME=__TARGET_HOME__
Environment=NVM_DIR=__TARGET_HOME__/.nvm
WorkingDirectory=__TARGET_HOME__/opencode-telegram-bot
ExecStart=__TARGET_HOME__/opencode-telegram-bot/run-bot.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT

sed -i \
  -e "s|__TARGET_USER__|$TARGET_USER|g" \
  -e "s|__TARGET_HOME__|$TARGET_HOME|g" \
  "$unit_tmp"
install -m 644 -o root -g root "$unit_tmp" /etc/systemd/system/opencode-telegram-bot.service
rm -f "$unit_tmp"

env_file="$TARGET_HOME/.config/opencode-telegram-bot/.env"
if [[ -d /run/systemd/system ]]; then
  systemctl daemon-reload
  if [[ -s "$env_file" ]]; then
    systemctl enable opencode-telegram-bot.service
    if systemctl is-active --quiet opencode-telegram-bot.service; then
      systemctl restart opencode-telegram-bot.service
    else
      systemctl start opencode-telegram-bot.service
    fi
    echo "160-opencode-telegram-bot: 服务已启用（用户 $TARGET_USER）"
  else
    echo "160-opencode-telegram-bot: 未找到 $env_file，unit 已落位但未启用/启动" >&2
  fi
else
  echo "160-opencode-telegram-bot: systemd 未运行（构建期？），文件已就位，未 enable"
fi

echo "160-opencode-telegram-bot: 完成（用户 $TARGET_USER；密钥请放 plugins/private/opencode-telegram-bot.env，由 080-private 落位）"
