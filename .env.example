# ubuntu-machine plugin settings
#
# Copy this file to .env (same directory) and uncomment what you need.
# .env is ignored by git and excluded from the Docker build context.
#
# Precedence: environment variables > .env > plugin defaults.
# Format: KEY=value, optional `export` prefix, whole-line `#` comments only.
# Quote values that contain spaces. List values are space-separated strings.
# The file is parsed, not sourced. Secrets belong in plugins/private/.

# 060-yazi: disable MIME detection, previews, and preloading for these globs.
# Empty disables the [plugin] section entirely.
# YAZI_NOOP_PATHS="/Users/<user>/Documents/sync/cloudreve/**"
# YAZI_VERSION=latest

# 155-uv
# UV_VERSION=0.13.6

# 110-rust: 1 builds tauri-cli (slow), 0 skips it
# INSTALL_TAURI_CLI=1

# 160-opencode-telegram-bot
# TELEGRAM_BOT_NODE_VERSION=v22.23.2

# 170-swapfile (container machine only)
# SWAPFILE_SIZE=4G
# SWAPFILE_PATH=/swapfile
# SWAPFILE_DRY_RUN=0

# Proxy settings are also read by the interactive zsh `pc` alias, which does
# not load this file, so normally export them in the shell instead.
# PROXY_HOST=192.168.64.1
# PROXY_PORT=20121
