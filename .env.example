# Copy to .env. Ignored by git and excluded from the image.
# Environment variables override this file. Secrets: plugins/private/.

# 060-yazi
# YAZI_NOOP_PATHS="/Users/<user>/Documents/sync/cloudreve/**"
# YAZI_VERSION=latest

# 155-uv
# UV_VERSION=0.13.6

# 110-rust
# INSTALL_TAURI_CLI=1

# 160-opencode-telegram-bot
# TELEGRAM_BOT_NODE_VERSION=v22.23.2

# 170-swapfile
# SWAPFILE_SIZE=4G
# SWAPFILE_PATH=/swapfile
# SWAPFILE_DRY_RUN=0

# Proxy is also read by the zsh pc alias, so export it in the shell instead.
# PROXY_HOST=192.168.64.1
# PROXY_PORT=20121
